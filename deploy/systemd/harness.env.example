# /etc/harness/harness.env — provider creds and runtime config for harness.service
# Install: sudo install -m 0600 -o root -g harness harness.env.example /etc/harness/harness.env
# Then edit /etc/harness/harness.env with real values. NEVER commit the populated file.

# --- Provider credentials (set whichever you use) --------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GITHUB_TOKEN=ghp_...

# --- OpenTelemetry (optional) ----------------------------------------------
# HARNESS_OTEL_ENDPOINT=http://otel-collector:4318
# HARNESS_OTEL_SERVICE_NAME=ai-harness
# HARNESS_OTEL_SAMPLE_RATIO=1.0

# --- Source-specific (optional) --------------------------------------------
# TELEGRAM_BOT_TOKEN=...

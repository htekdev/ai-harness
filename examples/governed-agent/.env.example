# Provider credential. The default model uses the GitHub Copilot endpoint and
# expects a token in GH_TOKEN.
GH_TOKEN=

# OpenTelemetry — optional. When set, every agent.turn / delegation /
# tools.call becomes a span shipped to your collector.
# HARNESS_OTEL_ENDPOINT=http://localhost:4318
# HARNESS_OTEL_SERVICE_NAME=governed-agent
# HARNESS_OTEL_SAMPLE_RATIO=1.0
